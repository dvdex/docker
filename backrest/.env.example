SITE_ID=example
DATA_ROOT=/opt/docker
TZ=Europe/Zurich
BACKREST_TAG=latest
BACKREST_DOMAIN=backrest.example.com
# Data set that Backrest backs up and restores (often the shared backup root).
BACKREST_USERDATA_PATH=/opt/docker/backup
PANGOLIN_SSO=false

# Backrest keeps its restic repository credentials in its own config file, so
# this stack has no Dockhand secrets. The container runs as root because the
# restic SSH key is mounted at /root/.ssh.
