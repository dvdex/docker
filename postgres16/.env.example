SITE_ID=example
DATA_ROOT=/opt/docker
PUID=1000
PGID=1000
TZ=Europe/Zurich
POSTGRES_TAG=16-vectorchord0.3.0
PGADMIN_TAG=latest
PGADMIN_DOMAIN=pgadmin.example.com
# HDD or SSD; tunes the VectorChord image defaults.
POSTGRES_DB_STORAGE_TYPE=HDD
PANGOLIN_SSO=false

# Store these as Dockhand secrets, not in this file.
POSTGRES_USER=
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
