SITE_ID=example
DATA_ROOT=/opt/docker
PUID=1000
PGID=1000
TZ=Europe/Zurich
VAULTWARDEN_TAG=1.35.4
VAULTWARDEN_DOMAIN=vaultwarden.example.com
VAULTWARDEN_ORG_NAME=home
OIDC_ISSUER=https://pocketid.example.com
SMTP_HOST=inbucket
SMTP_PORT=2500
# Vaultwarden does its own SSO, so Pangolin auth stays off by default.
PANGOLIN_SSO=false

# Store these as Dockhand secrets, not in this file.
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_SSO_CLIENT_ID=
VAULTWARDEN_SSO_CLIENT_SECRET=
