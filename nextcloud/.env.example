SITE_ID=example
DATA_ROOT=/opt/docker
PUID=1000
PGID=1000
TZ=Europe/Zurich
NEXTCLOUD_AIO_TAG=latest
NEXTCLOUD_DOMAIN=nextcloud.example.com
PANGOLIN_SSO=false

# AIO's HTTPS management UI is published on this host port. Keep 8080 free,
# or choose another unused host port; the container side must remain 8080.
NEXTCLOUD_AIO_PORT=8080

# AIO's Apache child listens here for Pangolin. Keep this away from 80/443;
# Pangolin reaches nextcloud-aio-apache on this port via the pangolin network.
NEXTCLOUD_APACHE_PORT=11000

# Talk publishes this port on the host for TURN/STUN (TCP and UDP). Keep it
# unique and allow both protocols through the host firewall if Talk is enabled.
NEXTCLOUD_TALK_PORT=3478

# Leave false unless domain validation cannot run and routing is already tested.
NEXTCLOUD_SKIP_DOMAIN_VALIDATION=false
