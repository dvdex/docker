SITE_ID=example
DATA_ROOT=/opt/docker
PUID=1000
PGID=1000
TZ=Europe/Zurich
SFTPGO_TAG=v2.6.6
# Web UI / HTTPS resource.
SFTPGO_DOMAIN=sftpgo.example.com
# Separate Pangolin resource for the WebDAV endpoint on port 5007.
SFTPGO_WEBDAV_DOMAIN=webdav.example.com
# SFTP stays a published host port because it is not HTTP.
SFTPGO_SFTP_PORT=2022
OIDC_ISSUER=https://pocketid.example.com
SMTP_HOST=inbucket
SMTP_PORT=2500
PANGOLIN_SSO=false

# Mounts exposed inside the SFTPGo virtual filesystem.
SFTPGO_BACKUP_PATH=/opt/docker/backup
SFTPGO_NOTES_PATH=/opt/docker/syncthing/data/user/Notes
SFTPGO_NOTES_TARGET=/srv/sftpgo/home/user/Notes
SFTPGO_IMMICH_UPLOAD_PATH=/opt/docker/immich/upload
SFTPGO_VIDEO_PATH=/opt/video

# Store these as Dockhand secrets, not in this file.
SFTPGO_DEFAULT_ADMIN_USERNAME=
SFTPGO_DEFAULT_ADMIN_PASSWORD=
SFTPGO_OIDC_CLIENT_ID=
SFTPGO_OIDC_CLIENT_SECRET=
