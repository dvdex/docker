SITE_ID=example
PUID=1000
PGID=1000
TZ=Europe/Zurich
PGBACKWEB_TAG=latest
PGBACKWEB_DOMAIN=pgbackweb.example.com
# Where dumps are written; usually the shared backup root of this site.
PGBACKWEB_BACKUP_PATH=/opt/docker/backup
PANGOLIN_SSO=false

# Store these as Dockhand secrets, not in this file.
PBW_ENCRYPTION_KEY=
PBW_POSTGRES_CONN_STRING=
