SITE_ID=example
DATA_ROOT=/opt/docker
PUID=1000
PGID=1000
TZ=Europe/Zurich
IMMICH_TAG=v2
IMMICH_ALBUM_CREATOR_TAG=latest
IMMICH_DOMAIN=immich.example.com
# Read-write library that Immich imports as an external library.
IMMICH_EXTERNAL_PATH=/opt/docker/sftpgo/data/home/user/photo
IMMICH_DB_NAME=immich
IMMICH_REDIS_DBINDEX=2
IMMICH_ALBUM_CREATOR_CRON=5 1 * * *
PANGOLIN_SSO=false

# Store these as Dockhand secrets, not in this file.
IMMICH_DB_USER=
IMMICH_DB_PASSWORD=
REDIS_PASSWORD=
IMMICH_API_KEY=
